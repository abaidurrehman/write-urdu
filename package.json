{
  "name": "write-urdu",
  "private": true,
  "scripts": {
    "start": "node scripts/dev-server.js",
    "test": "node scripts/run-contract-tests.js",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run seo:check && npm run governance:check && npm run test:browser",
    "seo:generate": "node scripts/generate-seo-files.js",
    "seo:sync-heads": "node scripts/sync-static-search-metadata.js --write",
    "seo:heads:check": "node scripts/sync-static-search-metadata.js --check",
    "seo:graph:sync": "node scripts/sync-static-seo-graph.js --write",
    "seo:graph:check": "node scripts/sync-static-seo-graph.js --check",
    "seo:check": "node scripts/check-seo.js && node scripts/check-urdu-locale-seo.js && npm run seo:heads:check",
    "seo:live": "node scripts/check-live-canonical.js",
    "seo:production": "node scripts/check-live-production.js",
    "seo:source-live": "node scripts/check-live-source-crawlability.js",
    "governance:check": "node scripts/check-product-governance.js",
    "seo:indexnow": "node scripts/submit-indexnow.js",
    "lighthouse:seo": "node scripts/run-lighthouse.js",
    "templates:check": "node scripts/validate-template-library.js",
    "templates:gsc": "node scripts/analyze-writing-template-gsc.js",
    "locale:generate": "node scripts/generate-urdu-locale.js",
    "locale:check": "node scripts/generate-urdu-locale.js --check",
    "shell:sync": "node scripts/sync-static-shell.js --write",
    "shell:check": "node scripts/sync-static-shell.js --check",
    "collections:sync": "node scripts/sync-static-collection-content.js --write",
    "collections:check": "node scripts/sync-static-collection-content.js --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/d1-adapter": "1.11.3",
    "qrcode": "^1.5.4"
  }
}
