{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "writeurdu-form-mailer",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "FORM_FROM_EMAIL": "forms@write-urdu.com"
  },
  "send_email": [
    {
      "name": "FORM_EMAIL",
      "destination_address": "REPLACE_WITH_YOUR_VERIFIED_DESTINATION",
      "allowed_sender_addresses": [
        "forms@write-urdu.com"
      ]
    }
  ]
}
